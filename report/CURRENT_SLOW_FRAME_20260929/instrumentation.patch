+function guard=localPhase(name)
+    global frameTiming;
+    started=tic;absoluteStart=toc(frameTiming.timer);iteration=frameTiming.iteration;
+    guard=onCleanup(@()localRecordPhase(name,started,absoluteStart,iteration));
+end
+function localRecordPhase(name,started,absoluteStart,iteration)
+    global frameTiming;
+    event=struct('phase',name,'seconds',toc(started),'startSeconds',absoluteStart,'iteration',iteration);
+    if isempty(frameTiming.events),frameTiming.events=event;else,frameTiming.events(end+1)=event;end
+end
+function [x,value,flag]=localTimedCone(kind,varargin)
+    global frameTiming;
+    phase=localPhase(kind);started=tic;
+    [x,value,flag,output]=coneprog(varargin{:});
+    entry=struct('kind',kind,'iteration',frameTiming.iteration,'seconds',toc(started), ...
+        'exitFlag',flag,'objective',value,'output',output,'budgetSeconds',varargin{9}.MaxTime, ...
+        'variables',numel(varargin{1}),'cones',numel(varargin{2}), ...
+        'inequalities',size(varargin{3},1),'equalities',size(varargin{5},1));
+    if isempty(frameTiming.coneCalls),frameTiming.coneCalls=entry;else,frameTiming.coneCalls(end+1)=entry;end
+    clear phase;
+end
+function result=localCandidateMetrics(candidate,model)
+    if isempty(candidate),result=struct('available',false);return;end
+    [~,~,deviation]=terminalContinuation.membership([candidate.states(:,end);candidate.inputs(:,end)], ...
+        model.sampleIndex+size(candidate.inputs,2),model.terminal);
+    result=struct('available',true,'cost',candidate.cost,'hard',candidate.hard,'safety',candidate.safety, ...
+        'clfSlack',candidate.clfSlack,'terminalNorm',norm(model.terminal.factor*deviation), ...
+        'terminalExcess',max(0,norm(model.terminal.factor*deviation)-model.terminal.radius), ...
+        'stagePhysicalViolation',max(candidate.stageHard), ...
+        'completionSafetyViolation',max([0,candidate.stageSafety(model.cfg.controller.horizonSteps+1:end)]));
+end
