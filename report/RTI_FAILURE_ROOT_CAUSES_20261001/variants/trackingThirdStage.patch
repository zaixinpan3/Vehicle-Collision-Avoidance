+        search.solverCalls=3;
+        search.stages(3)=struct('objective',"trackingCost",'exitFlag',flag3,'seconds',NaN,'value',NaN);
+        if ~isempty(third) && all(isfinite(third)),second=third(1:nv);end
+    end
     inputs=anchor.inputs+reshape(second(problem.inputIndices),size(anchor.inputs));
