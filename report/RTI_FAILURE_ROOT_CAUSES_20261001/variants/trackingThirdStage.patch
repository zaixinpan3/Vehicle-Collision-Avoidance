+    upper3=[problem.upper;Inf];upper3(problem.clfIndex)=max(0,second(problem.clfIndex))*(1+1e-9)+1e-12;
+    lower3=[problem.lower;0];
+    cones3=problem.cones;
+    for k=1:numel(cones3)
+        cones3(k)=secondordercone([cones3(k).A,sparse(size(cones3(k).A,1),1)],cones3(k).b,[cones3(k).d;0],cones3(k).gamma);
+    end
+    axis=sparse(1,nv+1);axis(end)=1;
+    cones3(end+1)=secondordercone([2*trackRows,sparse(5*count,1);-axis],[-2*trackOffset;-1],axis.',-1);
