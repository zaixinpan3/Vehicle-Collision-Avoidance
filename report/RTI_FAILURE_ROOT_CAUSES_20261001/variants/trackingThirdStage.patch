@@ -76,6 +76,33 @@
     if isempty(second) || any(~isfinite(second))
         search.terminationReason="clfNoNumericalResult";search.elapsedSeconds=toc(timer);return;
     end
+    % DIAGNOSTIC third stage: give the future plan an objective. Minimize the
+    % horizon tracking cost subject to both achieved slack levels.
+    count=size(anchor.inputs,2);nv=numel(objective);reference=model.nominalReference;
+    trackRows=sparse(5*count,nv);trackOffset=zeros(5*count,1);
+    for k=1:count
