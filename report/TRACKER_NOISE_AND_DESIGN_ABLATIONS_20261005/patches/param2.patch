+function runtime = localUpdateParameterStage(runtime, observerInput)
+% Prototype constant-parameter stage: A and beta are constant by the NRMM
+% contract. After acquisition the stage is the running mean of the tracker's
+% reconstruction (gain 1/n); once that gain falls to the certificate's decay
+% floor (1/domain transit time) it stays a first-order stage at that rate.
+    design = runtime.observerDesign;
+    ego = struct("bodyVelocity", runtime.bodyVelocityEstimate, "yawRate", observerInput.yawRate);
+    [~, tracker] = nrmmTargetTrackerDerivative(runtime.targetState, ego, design.target.domain);
+    stage = runtime.parameterStage;
+    if ~stage.initialized
+        stage.acceleration = tracker.targetScalarAcceleration;
+        stage.sideslip = tracker.targetSideslip;
+        stage.initialized = true;stage.count = 1;
+    else
+        stage.count = stage.count+1;
+        gain = max(1/stage.count,1-exp(-design.target.minimumDecayRate*runtime.samplePeriod));
+        stage.acceleration = stage.acceleration+gain*(tracker.targetScalarAcceleration-stage.acceleration);
+        stage.sideslip = stage.sideslip+gain*(tracker.targetSideslip-stage.sideslip);
+    end
+    runtime.parameterStage = stage;
+end
